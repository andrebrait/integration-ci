#!/usr/bin/env bash
# integration — rebuild/build/deploy/push a fork's integration branch, then rebase
# this account's open PRs to upstream onto their latest bases and push them: to
# FORK_REMOTE, and also to the PR's own head repository when that is another
# remote here (e.g. a personal fork), so the upstream PR itself moves too.
#
# The integration branch is not a long-lived patch series: `rebuild` recreates it
# every round as BASE plus one squashed commit per still-open PR, so a PR that was
# merged or closed upstream drops out by construction and no residue survives.
#
# Usage:
#   integration <rebuild|build|deploy|push|prs|all> [repo-dir=$PWD]
#
# Per-repo config: ~/.config/integration/<slug>.sh  (slug = repo path, "/" -> "--")
#   FORK_REMOTE=origin          # remote name of the fork (push target); default origin
#   UPSTREAM=owner/repo         # gh slug used to list open PRs; unset = skip prs
#   BRANCH=integration          # integration branch name; default integration
#   BASE=upstream/main          # what the PRs are rebuilt onto: a ref or "latest-tag"
#   UPSTREAM_MAIN_REF=upstream/main
#   FORMAT_CMD='...'            # optional, runs on each squashed merge before it commits
#   EXTRA_PRS='12229=carry/pr-12229 fork/repo#1=local-draft'
#                               # optional, space-separated PR=fork-branch pairs for PRs
#                               # we carry. PR is a bare UPSTREAM number or a repo-qualified
#                               # owner/repo#N (a PR in another repo, e.g. a draft opened in
#                               # the fork), looked up in its own repo. The fork branch holds
#                               # our rebased/fixed copy; it is squashed and rebased like our
#                               # own PRs while the PR is open, and dropped once it is merged
#                               # or closed. A separate third-party source head is never pushed.
#   STACKED_PRS='14458:14148 fork/repo#2:fork/repo#1'
#                               # optional, space-separated CHILD:PARENT[,PARENT2...] pairs
#                               # (each a bare number or owner/repo#N) for PRs whose branch
#                               # is built on another open PR's branch. `prs` rebases the
#                               # child onto the parent's rebased branch (not the upstream
#                               # base), and `rebuild` squashes only the child's own commits,
#                               # after its parent. At one stack depth rows run bare UPSTREAM
#                               # numbers first, then qualified IDs, each by PR number.
# Fixups: ~/.config/integration/fixups/<slug>/<N>-<name>.patch (`git diff --full-index`)
#                               # is applied with `git apply --3way` into PR #N's squash.
#                               # For a change that adapts PR #N to PRs squashed before
#                               # it and that no single PR branch can hold.
#                               # A qualified PR is named by its whole ID: fixups/<slug>/owner/repo#N-<name>.patch
#   <N>-resolve.patch            # optional exact conflict-marker resolution. Every
#                               # unresolved path must have its full preimage hash
#                               # in this patch; applies strictly, never with 3-way.
#   BUILD_CMD='...'             # runs inside a clean detached worktree at $BRANCH
#   TEST_CMD='...'              # optional, runs after BUILD_CMD in the same worktree
#   CI_REPO=owner/repo          # optional: build dispatches CI_WORKFLOW there for the
#   CI_WORKFLOW=omp.yml         # branch head instead of running BUILD_CMD/TEST_CMD here;
#                               # the run's artifacts become BUILD_DIR. The head is first
#                               # pushed to FORK_REMOTE as $BRANCH-next so CI can fetch it.
#                               # A commit already published in CI_REPO is reused, not rebuilt.
#   CI_TARGET=linux-x64         # optional, for a multi-platform workflow: the target whose
#                               # binary becomes BUILD_DIR (the host's own platform).
#   DEPLOY_CMD='...'            # runs with BUILD_DIR, DEPLOY_SHA, DEPLOY_BASE exported
#   POST_CMD='...'             # optional, runs after DEPLOY_CMD succeeds; same exports
#
# If a DEPLOY_CMD restarts a service that hosts running agent sessions (e.g. the
# ompweb API unit parents omp RPC children via nginx /api/), restart it LAST:
# the restart kills those sessions mid-command (exit 143) and the agent resumes
# after the service returns. Verify deployments after resuming.
# Conflicts: a subcommand may stop mid-rebase. Resolve the conflicts, then re-run
# the SAME subcommand — an in-progress rebase resumes instead of restarting.
# Never commit feature work on the integration branch: `rebuild` refuses while it
# carries non-`PR #<n>:` / `PR owner/repo#<n>:` commits (override: INTEGRATION_DROP_NON_PR=1, only once
# they live on a PR branch). Only one run per project at a time (flock on
# $CACHE/lock); a concurrent run exits 75.
set -euo pipefail

CMD="${1:-}"
[ -n "$CMD" ] || { sed -n '2,20p' "$0"; exit 2; }
shift || true
SRC_DIR="${1:-$PWD}"
COMMON_GIT="$(git -C "$SRC_DIR" rev-parse --path-format=absolute --git-common-dir)"
REPO_DIR="$(dirname "$COMMON_GIT")"
SLUG="$(printf %s "$REPO_DIR" | sed 's#^/##; s#/#--#g')"
CONF="$HOME/.config/integration/$SLUG.sh"
FIXUP_DIR="$HOME/.config/integration/fixups/$SLUG"
CACHE="$HOME/.cache/integration/$SLUG"
mkdir -p "$CACHE"
# One integration run per project at a time: two concurrent runs share the
# integration worktree, build dirs, rerere cache and fork refs, and clobber each
# other. The lock is per repo (keyed like CACHE) and released when this process
# exits; deploy/post commands close it so a service they spawn cannot keep it.
exec 9>"$CACHE/lock"
if ! flock -n 9; then
	echo "integration: another integration run holds $CACHE/lock (pid $(cat "$CACHE/lock.pid" 2>/dev/null || echo '?')); refusing to start" >&2
	exit 75
fi
printf '%s %s\n' "$$" "${*:-}" > "$CACHE/lock.pid"
[ -f "$CONF" ] || { echo "integration: missing config $CONF" >&2; exit 2; }
# shellcheck disable=SC1090
source "$CONF"
FORK_REMOTE="${FORK_REMOTE:-origin}"
BRANCH="${BRANCH:-integration}"
BASE="${BASE:-latest-tag}"
UPSTREAM_MAIN_REF="${UPSTREAM_MAIN_REF:-upstream/main}"
# A PR ID is a bare UPSTREAM number or a repo-qualified owner/repo#N. Each name part
# starts with a non-dot so the ID stays valid inside a git ref and a path.
PR_QUALIFIED='[A-Za-z0-9_-][A-Za-z0-9._-]*/[A-Za-z0-9_-][A-Za-z0-9._-]*#[0-9]+'
PR_ID="([0-9]+|$PR_QUALIFIED)"
for pair in ${EXTRA_PRS:-}; do
	[[ "$pair" =~ ^$PR_ID=[^=]+$ ]] || { echo "integration: bad EXTRA_PRS entry '$pair' (want N=fork-branch or owner/repo#N=fork-branch)" >&2; exit 2; }
done
for pair in ${STACKED_PRS:-}; do
	[[ "$pair" =~ ^$PR_ID:$PR_ID(,$PR_ID)*$ ]] || { echo "integration: bad STACKED_PRS entry '$pair' (want CHILD:PARENT[,PARENT2...]; each N or owner/repo#N)" >&2; exit 2; }
done

# How messages and commit subjects name a PR: #N, or owner/repo#N for qualified IDs.
pr_label() { case "$1" in *#*) echo "$1" ;; *) echo "#$1" ;; esac; }

stack_parent() { # num -> parent PR number(s) (comma-separated) or empty
	local pair
	for pair in ${STACKED_PRS:-}; do
		[ "${pair%%:*}" = "$1" ] && { echo "${pair#*:}"; return 0; }
	done
	return 0
}

stack_depth() { # num [seen] -> max parent depth + 1 (0 if unstacked)
	local num="$1" seen="${2:-} $1 " ps p d max=0
	ps="$(stack_parent "$num")"
	[ -n "$ps" ] || { echo 0; return 0; }
	for p in ${ps//,/ }; do
		case "$seen" in *" $p "*) echo "integration: STACKED_PRS has a cycle through $(pr_label "$num")" >&2; return 1 ;; esac
		d="$(stack_depth "$p" "$seen")" || return 1
		[ "$((d + 1))" -le "$max" ] || max=$((d + 1))
	done
	echo "$max"
}

# Field 2 (the fork branch) of PR $1's row in $2, or empty when it is not listed.
row_branch() { # num rows -> branch
	awk -F '\t' -v n="$1" '($1 "") == (n "") { print $2 }' <<< "$2"
}

worktrees_root() {
	local main
	main="$(dirname "$COMMON_GIT")"
	echo "$(dirname "$main")/.$(basename "$main")_worktrees"
}

branch_worktree() {
	git -C "$REPO_DIR" worktree list --porcelain | awk -v b="refs/heads/$1" '
		/^worktree / { p = substr($0, 10) }
		/^branch /   { if (substr($0, 8) == b) print p }'
}

rebase_in_progress() { # dir -> 0/1
	local gd
	gd="$(git -C "$1" rev-parse --git-dir 2>/dev/null || true)"
	[ -n "$gd" ] && { [ -d "$gd/rebase-merge" ] || [ -d "$gd/rebase-apply" ]; }
}

# Ask the remote directly: FETCH_HEAD is shared by every fetch in $REPO_DIR,
# so a concurrent fetch can make it name another branch's commit.
remote_sha() { # remote branch -> sha
	git -C "$REPO_DIR" ls-remote --exit-code "$1" "refs/heads/$2" | cut -f1
}

base_ref() {
	if [ "$BASE" = "latest-tag" ]; then
		git -C "$REPO_DIR" tag --sort=-creatordate --merged "$UPSTREAM_MAIN_REF" | head -1
	else
		echo "$BASE"
	fi
}

# Open PRs to integrate: this account's own plus EXTRA_PRS still open in their own
# repo, by stack depth (every STACKED_PRS child after its parent), then bare UPSTREAM
# numbers before qualified IDs, then PR number.
# Emits "id<TAB>fork-branch<TAB>field".
# Callers capture it with rows="$(...)": errexit is off inside command
# substitution, so each gh failure exits explicitly and pipefail carries it out,
# aborting instead of silently dropping a PR from the rebuild.
pr_rows() { # title|base
	local field pair num head row repo kind me
	[ "$1" = title ] && field=title || field=baseRefName
	# `--author` goes through GitHub's search index, which intermittently answers with
	# no results; a short list made rebuilds drop every PR it lacked. List open PRs
	# directly and filter by the authenticated login instead.
	me="$(gh api user --jq .login)" || exit 1
	{
		gh pr list --repo "$UPSTREAM" --state open --limit 5000 \
			--json number,headRefName,"$field",author \
			--jq ".[] | select(.author.login == \"$me\") | [.number, .headRefName, .$field] | @tsv" || exit 1
		for pair in ${EXTRA_PRS:-}; do
			num="${pair%%=*}" head="${pair#*=}" repo="${num%#*}"
			[ "$repo" != "$num" ] || repo="$UPSTREAM"
			row="$(gh pr view "${num##*#}" --repo "$repo" --json state,"$field" --jq "[.state, .$field] | @tsv")" || exit 1
			if [ "${row%%$'\t'*}" != OPEN ]; then
				echo "integration: extra PR $(pr_label "$num") is ${row%%$'\t'*} in $repo; skipping (remove it from EXTRA_PRS)" >&2
				continue
			fi
			printf '%s\t%s\t%s\n' "$num" "$head" "${row#*$'\t'}"
		done
	} | while IFS=$'\t' read -r num head row; do
		# Stack depth leads the sort key, so parents always precede children; at one
		# depth bare UPSTREAM numbers precede qualified IDs, ordered by PR number.
		local depth
		depth="$(stack_depth "$num")" || exit 1
		kind=0
		[[ "$num" != *#* ]] || kind=1
		printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$depth" "$kind" "${num##*#}" "$num" "$head" "$row"
	done | sort -t $'\t' -k1,1n -k2,2n -k3,3n | cut -f4-
}

# Replay one PR branch onto BASE in a scratch worktree, so a PR based on upstream
# main never drags post-BASE upstream commits into a tag-based integration branch.
# A stacked PR passes its parent's branch as `from`: only the commits after the
# parent's tip are replayed, since the parent is squashed separately.
# Echoes the ref holding the replayed series.
replay_pr() { # scratch-worktree base head-ref tmp-branch [from-ref] -> ref
	local scratch="$1" base="$2" head="$3" tmp="$4" mb
	mb="$(git -C "$REPO_DIR" merge-base "${5:-$base}" "$head")"
	git -C "$scratch" checkout -q -B "$tmp" "$head"
	if [ "$mb" != "$(git -C "$REPO_DIR" rev-parse "$base")" ]; then
		# Command substitution swallows errexit: abort and fail explicitly, or the
		# caller squashes a half-applied series.
		git -C "$scratch" rebase --onto "$base" "$mb" "$tmp" >/dev/null || {
			git -C "$scratch" rebase --abort 2>/dev/null
			echo "integration: replaying $head onto $base failed; run 'integration prs' to rebase it first" >&2
			return 1
		}
	fi
	echo "$tmp"
}

# replay_pr for PR #num, stacked PRs on top of their parent's replayed series
# (recursively). Reads cmd_rebuild's scratch, base and rows. Echoes the ref.
replay_stack() { # num -> ref (also sets rebuild/pr-$num-base when stacked on open parent(s))
	local num="$1" parent p pb from head_ref join_commit match i
	local -a open_parents=() open_pbs=()
	head_ref="$FORK_REMOTE/$(row_branch "$num" "$rows")"
	parent="$(stack_parent "$num")"
	for p in ${parent//,/ }; do
		pb="$(row_branch "$p" "$rows")"
		[ -z "$pb" ] || { open_parents+=("$p"); open_pbs+=("$pb"); }
	done
	git -C "$scratch" branch -D "rebuild/pr-$num-base" >/dev/null 2>&1 || true
	if [ "${#open_parents[@]}" -eq 0 ]; then
		replay_pr "$scratch" "$base" "$head_ref" "rebuild/pr-$num"
	elif [ "${#open_parents[@]}" -eq 1 ]; then
		from="$(replay_stack "${open_parents[0]}")" || return 1
		git -C "$scratch" branch -f "rebuild/pr-$num-base" "$from" >/dev/null
		replay_pr "$scratch" "$from" "$head_ref" "rebuild/pr-$num" "$FORK_REMOTE/${open_pbs[0]}"
	else
		for p in "${open_parents[@]}"; do
			replay_stack "$p" >/dev/null || return 1
		done
		join_commit="$(git -C "$REPO_DIR" rev-list --merges --first-parent "$UPSTREAM_MAIN_REF..$head_ref" | head -1)"
		[ -n "$join_commit" ] || { echo "integration: PR $(pr_label "$num") has multiple parents ($parent) but no merge commit in $UPSTREAM_MAIN_REF..$head_ref" >&2; return 1; }
		match=1
		for i in "${!open_parents[@]}"; do
			p="${open_parents[$i]}"
			if [ "$(git -C "$REPO_DIR" rev-parse "$join_commit^$((i + 1))" 2>/dev/null || true)" != "$(git -C "$REPO_DIR" rev-parse "rebuild/pr-$p")" ]; then
				match=0
				break
			fi
		done
		if [ "$match" -eq 1 ]; then
			git -C "$scratch" branch -f "rebuild/pr-$num-base" "$join_commit" >/dev/null
			git -C "$scratch" checkout -q -B "rebuild/pr-$num" "$head_ref"
			echo "rebuild/pr-$num"
		else
			git -C "$scratch" checkout -q -B "rebuild/pr-$num-base" "rebuild/pr-${open_parents[0]}"
			for p in "${open_parents[@]:1}"; do
				if ! git -C "$scratch" merge --no-edit "rebuild/pr-$p" >/dev/null 2>&1; then
					if [ -n "$(git -C "$scratch" diff --diff-filter=U --name-only)" ]; then
						git -C "$scratch" merge --abort 2>/dev/null || true
						echo "integration: joining parents (${open_parents[*]}) for PR $(pr_label "$num") failed; run 'integration prs' first" >&2
						return 1
					fi
					git -C "$scratch" commit --no-edit -q
				fi
			done
			replay_pr "$scratch" "rebuild/pr-$num-base" "$head_ref" "rebuild/pr-$num" "$join_commit"
		fi
	fi
}

cmd_rebuild() {
	[ -n "${UPSTREAM:-}" ] || { echo "integration: UPSTREAM not set; rebuild needs the PR list" >&2; exit 2; }
	git -C "$REPO_DIR" fetch "$FORK_REMOTE" --tags --prune
	git -C "$REPO_DIR" fetch upstream --tags --prune
	local base wt pre root scratch num head title tmp key resumed done_prs squashed squashed_head squashed_sha rows parent parent_branch own squash fixups patch lbl
	rows="$(pr_rows title)"
	base="$(base_ref)"
	key="${BRANCH//\//--}"
	# During a rebuild the worktree sits on a detached HEAD, so the branch lookup
	# cannot find it on a resume run; the path is remembered for that case.
	wt="$(branch_worktree "$BRANCH")"
	[ -n "$wt" ] || wt="$(cat "$CACHE/$key.worktree" 2>/dev/null || true)"
	[ -n "$wt" ] && [ -d "$wt" ] || { echo "integration: branch $BRANCH not checked out in any worktree" >&2; exit 1; }
	printf %s "$wt" > "$CACHE/$key.worktree"
	if rebase_in_progress "$wt"; then
		echo "integration: $wt has a rebase in progress; finish or abort it first" >&2
		exit 1
	fi
	[ -z "$(git -C "$wt" status --porcelain)" ] || { echo "integration: $wt is dirty; commit or discard first" >&2; exit 1; }
	# A conflicting PR is resolved and committed by hand; re-running must continue
	# from the next PR instead of discarding that work, so an interrupted rebuild
	# is resumed only while HEAD is detached at BASE plus `PR #<n>:` / `PR owner/repo#<n>:` commits. rerere
	# replays textual conflicts, but a semantic fixup (an API a later PR renamed)
	# lives only in that commit.
	#
	# Each squash records the branch sha it came from: a PR pushed since then makes
	# the existing series stale, so the rebuild starts over instead of silently
	# reproducing the old code.
	resumed=""
	done_prs=""
	if ! git -C "$wt" symbolic-ref -q HEAD >/dev/null &&
		git -C "$REPO_DIR" merge-base --is-ancestor "$base" "$(git -C "$wt" rev-parse HEAD)" 2>/dev/null &&
		[ -n "$(git -C "$wt" log --format=%s "$base"..HEAD)" ] &&
		! git -C "$wt" log --format=%s "$base"..HEAD | grep -qvE "^PR (#[0-9]+|$PR_QUALIFIED): "; then
		resumed=1
		squashed="$(git -C "$wt" log --format=%b "$base"..HEAD |
			sed -nE 's#^Squashed from [^/]+/(.+) \(([0-9a-f]+)\) onto .*#\1 \2#p')"
		# Every PR commit must carry its source sha; a series without them predates
		# this check and cannot be proven current.
		if [ "$(printf '%s\n' "$squashed" | grep -c .)" != "$(git -C "$wt" log --format=%s "$base"..HEAD | grep -c '^PR ')" ]; then
			echo "integration: squashed series does not record its PR shas; rebuilding from scratch"
			resumed=""
		fi
		while read -r squashed_head squashed_sha; do
			[ -n "$squashed_head" ] || continue
			if [ "$(git -C "$REPO_DIR" rev-parse "$FORK_REMOTE/$squashed_head" 2>/dev/null)" != "$squashed_sha" ]; then
				echo "integration: $FORK_REMOTE/$squashed_head moved since it was squashed; rebuilding from scratch"
				resumed=""
				break
			fi
		done <<< "$squashed"
		if [ -n "$resumed" ]; then
			done_prs="$(git -C "$wt" log --format=%s "$base"..HEAD | sed -nE "s~^PR #([0-9]+):.*~\1~p; s~^PR ($PR_QUALIFIED):.*~\1~p")"
		fi
	fi
	root="$(worktrees_root)"
	scratch="$root/rebuild-scratch"
	git -C "$REPO_DIR" worktree remove --force "$scratch" 2>/dev/null || rm -rf "$scratch"
	git -C "$REPO_DIR" worktree add --detach "$scratch" "$base" >/dev/null
	if [ -n "$resumed" ]; then
		echo "integration: resuming rebuild of $BRANCH from $base ($(echo "$done_prs" | wc -w) PRs already squashed)"
	else
		# A rebuild keeps only `PR #<n>:` / `PR owner/repo#<n>:` squashes. Anything else on the branch was
		# committed straight onto integration and would be silently discarded, so
		# stop and name it: it belongs on its own PR branch. Set
		# INTEGRATION_DROP_NON_PR=1 once every listed commit is carried by a PR or
		# deliberately abandoned.
		local stray
		stray="$(for ref in "$BRANCH" "$FORK_REMOTE/$BRANCH"; do
			git -C "$REPO_DIR" rev-parse -q --verify "$ref" >/dev/null || continue
			git -C "$REPO_DIR" log --no-merges --format='%h %s' "$base..$ref"
		done | grep -vE "^[0-9a-f]+ PR (#[0-9]+|$PR_QUALIFIED): " | sort -u -k2 || true)"
		if [ -n "$stray" ] && [ "${INTEGRATION_DROP_NON_PR:-}" != 1 ]; then
			echo "integration: $BRANCH carries commits that are not PR squashes; a rebuild would drop them:" >&2
			sed 's/^/  /' <<< "$stray" >&2
			echo "integration: move them to a PR branch, then re-run with INTEGRATION_DROP_NON_PR=1." >&2
			exit 1
		fi
		[ -z "$stray" ] || echo "integration: dropping non-PR commits (INTEGRATION_DROP_NON_PR=1): $(echo "$stray" | wc -l)"
		pre="$(git -C "$REPO_DIR" rev-parse "$FORK_REMOTE/$BRANCH")"
		printf %s "$pre" > "$CACHE/$key.pre-sha"
		printf %s "$base" > "$CACHE/base-ref"
		git -C "$REPO_DIR" branch -f "backup/$BRANCH-$(date +%Y%m%d-%H%M)" "$BRANCH"
		echo "integration: rebuilding $BRANCH from $base (pre-rebuild $FORK_REMOTE/$BRANCH ${pre:0:9})"
		git -C "$wt" checkout -q --detach "$base"
	fi
	while IFS=$'\t' read -r num head title; do
		[ -n "$num" ] || continue
		lbl="$(pr_label "$num")"
		if [ -n "$done_prs" ] && printf '%s\n' $done_prs | grep -qxFe "$num"; then
			echo "integration: PR $lbl already squashed; skipping"
			continue
		fi
		parent="$(stack_parent "$num")"
		for p in ${parent//,/ }; do
			if [ -z "$(row_branch "$p" "$rows")" ]; then
				echo "integration: PR $lbl is stacked on $(pr_label "$p"), which is not open" >&2
			fi
		done
		tmp="$(replay_stack "$num")" || exit 1
		echo "integration: squashing PR $lbl ($head)"
		# --squash records no second parent: the result stays a linear series that
		# rebuilds identically next round, and rerere replays cross-PR resolutions.
		# A stacked PR contributes only its diff against its replayed parent(s),
		# collapsed into one commit and cherry-picked: its branch also carries the
		# parent's commits, which the parent's own squash (fixups included) owns.
		# Both commands report failure even when rerere staged every conflict, so
		# the unresolved-path list, not the exit status, decides whether this
		# round still needs a human.
		if git -C "$REPO_DIR" rev-parse -q --verify "refs/heads/rebuild/pr-$num-base" >/dev/null; then
			# Conflict labels include this scratch SHA; keep it clone-stable.
			own="$(GIT_AUTHOR_NAME=integration GIT_AUTHOR_EMAIL=integration@localhost \
				GIT_COMMITTER_NAME=integration GIT_COMMITTER_EMAIL=integration@localhost \
				GIT_AUTHOR_DATE=2000-01-01T00:00:00Z GIT_COMMITTER_DATE=2000-01-01T00:00:00Z \
				git -C "$REPO_DIR" commit-tree "$tmp^{tree}" -p "rebuild/pr-$num-base" -m "PR $lbl")"
			squash=(cherry-pick --no-commit "$own")
		else
			squash=(merge --squash "$tmp")
		fi
		fixups=()
		for patch in "$FIXUP_DIR/$num"-*.patch; do
			[ -f "$patch" ] && [ "$patch" != "$FIXUP_DIR/$num-resolve.patch" ] && fixups+=("$patch")
		done
		if ! git -C "$wt" -c merge.conflictStyle=merge -c core.abbrev=7 "${squash[@]}" >/dev/null && [ -n "$(git -C "$wt" diff --diff-filter=U --name-only)" ]; then
			local resolve="$FIXUP_DIR/$num-resolve.patch" path expected actual patch_paths
			local -a unresolved=()
			mapfile -t unresolved < <(git -C "$wt" diff --diff-filter=U --name-only)
			if [ ! -f "$resolve" ]; then
				echo "integration: PR $lbl conflicts with the PRs squashed before it." >&2
				echo "integration: resolve in $wt, then commit it as 'PR $lbl: <title>'" >&2
				[ "${#fixups[@]}" -eq 0 ] || echo "integration: after applying its fixups with 'git apply --3way': ${fixups[*]}" >&2
				echo "integration: and re-run 'integration rebuild' to continue from the next PR." >&2
				exit 1
			fi
			patch_paths="$(git -C "$wt" apply --numstat "$resolve" | cut -f3-)" || exit 1
			if [ "$(printf '%s\n' "${unresolved[@]}" | sort)" != "$(printf '%s\n' "$patch_paths" | sort)" ]; then
				echo "integration: $resolve must cover exactly all unresolved paths in $wt; review and refresh it." >&2
				exit 1
			fi
			for path in "${unresolved[@]}"; do
				expected="$(awk -v header="diff --git a/$path b/$path" '
					$0 == header { found=1; next }
					found && $1 == "index" { sub(/\.\..*/, "", $2); print $2; exit }
				' "$resolve")"
				actual="$(git -C "$wt" hash-object -- "$path")"
				if [ "$expected" != "$actual" ]; then
					echo "integration: $resolve preimage mismatch for $path (expected $expected, actual $actual); review in $wt." >&2
					exit 1
				fi
			done
			# Only verified marker blobs become stage 0; no fuzzy/3-way resolution.
			git -C "$wt" add -- "${unresolved[@]}"
			if ! git -C "$wt" apply --index "$resolve" ||
				[ -n "$(git -C "$wt" diff --diff-filter=U --name-only)" ] ||
				git -C "$wt" grep -n -E '^(<<<<<<< |=======$|>>>>>>> )' -- "${unresolved[@]}"; then
				echo "integration: strict resolution $resolve failed or left conflict markers; inspect $wt before continuing." >&2
				exit 1
			fi
			echo "integration: applied exact resolution $(basename "$resolve") to PR $lbl"
		fi
		# Fixups adapt a PR to the PRs squashed before it where no single branch can
		# hold the change (e.g. handlers one PR adds in a file another PR splits).
		# They are part of the PR's squash, so a from-scratch rebuild reproduces it.
		for patch in "${fixups[@]}"; do
			if ! git -C "$wt" apply --3way "$patch" >/dev/null 2>&1; then
				echo "integration: fixup $patch no longer applies to PR $lbl; the squash is staged in $wt." >&2
				echo "integration: finish it there, refresh the patch, commit as 'PR $lbl: $title', and re-run 'integration rebuild'." >&2
				exit 1
			fi
			echo "integration: applied fixup $(basename "$patch") to PR $lbl"
		done
		# A squash that splices two PRs' hunks together can land formatting the
		# repo's own checks reject; the formatter runs before the commit so the
		# result is exactly what a rebuild reproduces.
		if [ -n "${FORMAT_CMD:-}" ]; then
			if ! ( cd "$wt" && eval "$FORMAT_CMD" >/dev/null ); then
				echo "integration: FORMAT_CMD failed for PR $lbl; the squash is staged uncommitted in $wt." >&2
				echo "integration: fix the formatter, run it there, commit as 'PR $lbl: $title', and re-run 'integration rebuild'." >&2
				exit 1
			fi
			git -C "$wt" add -A
		fi
		git -C "$wt" commit -q -m "PR $lbl: $title" \
			-m "Squashed from $FORK_REMOTE/$head ($(git -C "$REPO_DIR" rev-parse "$FORK_REMOTE/$head")) onto $base." || true
	done <<< "$rows"
	git -C "$REPO_DIR" worktree remove --force "$scratch"
	git -C "$wt" checkout -q -B "$BRANCH"
	echo "integration: $BRANCH rebuilt at $(git -C "$wt" rev-parse --short HEAD) (base $base, $(git -C "$REPO_DIR" rev-list --count "$base..$BRANCH") PRs)"
}

# Build the branch head on GitHub Actions: CI can only fetch a commit some ref
# points to, so the head goes to $BRANCH-next first (a scratch ref nothing else
# reads), and $BRANCH itself moves only after the run is green.
cmd_build_ci() {
	local sha slug out id url dir cfg
	sha="$(git -C "$REPO_DIR" rev-parse "$BRANCH")"
	slug="$(git -C "$REPO_DIR" remote get-url "$FORK_REMOTE" | sed -E 's#^.*github\.com[:/]##; s#\.git$##')"
	# CI sources this config and runs the workflow from CI_REPO's origin/main,
	# not from this checkout: an unpushed TEST_CMD edit would silently not run.
	cfg="$(git -C "$(dirname "$(readlink -f "$CONF")")" rev-parse --show-toplevel)"
	git -C "$cfg" fetch -q origin main
	if ! git -C "$cfg" diff --quiet origin/main -- "$(readlink -f "$CONF")" .github; then
		echo "integration: $CONF or $cfg/.github differs from $CI_REPO origin/main; commit and push $cfg first (CI reads origin/main)" >&2
		exit 1
	fi
	dir="$CACHE/ci-build-$sha"
	rm -rf "$dir" "$dir.dl"
	# A commit already built and published is reused as-is: the zip holds exactly
	# what that run built and tested. A missing release or API error means build.
	# With CI_TARGET (a multi-platform build), only that target's zip/artifact is
	# fetched: <project>-<stamp>-<sha10>-<target>.zip, artifact <artifact>-<target>.
	local release artifact asset suffix="${CI_TARGET:+-$CI_TARGET}"
	release="$(sed -nE 's/^ +project: *//p' "$cfg/.github/workflows/$CI_WORKFLOW" | head -1)"
	artifact="$(sed -nE 's/^ +artifact: *//p' "$cfg/.github/workflows/$CI_WORKFLOW" | head -1)"
	asset="$(gh release view "$release" -R "$CI_REPO" --json assets \
		--jq "[.assets[].name | select(startswith(\"$release-\") and endswith(\"-${sha:0:10}$suffix.zip\"))] | sort | last // empty" 2>/dev/null || true)"
	if [ -n "$release" ] && [ -n "$asset" ]; then
		echo "integration: $BRANCH @ ${sha:0:10} is already built and published as $asset; reusing it"
		gh release download "$release" -R "$CI_REPO" -p "$asset" -D "$dir.dl"
		unzip -q "$dir.dl/$asset" -d "$dir"
		rm -rf "$dir.dl"
	else
		git -C "$REPO_DIR" push -q --force "$FORK_REMOTE" "$sha:refs/heads/$BRANCH-next"
		out="$(gh workflow run "$CI_WORKFLOW" -R "$CI_REPO" -f repo="$slug" -f sha="$sha" 2>&1)" || {
			echo "integration: dispatching $CI_WORKFLOW in $CI_REPO failed: $out" >&2
			exit 1
		}
		# gh prints the URL of the run this dispatch created, so a rerun of the
		# same sha can never be confused with an older run.
		id="$(sed -nE 's#.*/actions/runs/([0-9]+).*#\1#p' <<< "$out" | head -1)"
		[ -n "$id" ] || { echo "integration: no run URL in gh output (gh >= 2.81 required): $out" >&2; exit 1; }
		url="https://github.com/$CI_REPO/actions/runs/$id"
		echo "integration: building $BRANCH @ ${sha:0:10} in CI: $url"
		if ! gh run watch "$id" -R "$CI_REPO" --exit-status --interval 30 >/dev/null; then
			echo "integration: CI build failed: $url" >&2
			exit 1
		fi
		gh run download "$id" -R "$CI_REPO" ${CI_TARGET:+-n "$artifact-$CI_TARGET"} -D "$dir.dl"
		# gh nests each artifact in a directory named after it, which may match the
		# file inside (omp/omp); collect the files into a fresh BUILD_DIR.
		mkdir -p "$dir"
		find "$dir.dl" -type f -exec mv -t "$dir" {} +
		rm -rf "$dir.dl"
	fi
	chmod +x "$dir"/*
	echo "integration: CI build OK ($dir)"
	if [ "$(git -C "$REPO_DIR" rev-parse "$BRANCH")" != "$sha" ]; then
		echo "integration: $BRANCH moved during the CI build (tested ${sha:0:10}); not pushing, re-run build" >&2
		exit 1
	fi
	# Only now is $dir the build of $BRANCH: deploy reads build-dir with
	# DEPLOY_SHA = $BRANCH, and older downloads (~230 MB each) are dead weight.
	printf %s "$dir" > "$CACHE/build-dir"
	find "$CACHE" -maxdepth 1 -name 'ci-build-*' ! -path "$dir" -exec rm -rf {} +
	cmd_push
}

cmd_build() {
	if [ -n "${CI_REPO:-}" ]; then cmd_build_ci; return; fi
	[ -n "${BUILD_CMD:-}" ] || { echo "integration: BUILD_CMD not set in $CONF" >&2; exit 2; }
	local sha root wt
	sha="$(git -C "$REPO_DIR" rev-parse "$BRANCH")"
	root="$(worktrees_root)"
	wt="$root/build-${sha:0:10}"
	git -C "$REPO_DIR" worktree remove --force "$wt" 2>/dev/null || rm -rf "$wt"
	git -C "$REPO_DIR" worktree add --detach "$wt" "$sha" >/dev/null
	echo "integration: building $BRANCH @ ${sha:0:10} in $wt"
	( cd "$wt" && eval "$BUILD_CMD" )
	if [ -n "${TEST_CMD:-}" ]; then
		echo "integration: running downstream-patch tests"
		( cd "$wt" && eval "$TEST_CMD" )
	fi
	printf %s "$wt" > "$CACHE/build-dir"
	echo "integration: build OK at $wt"
	# A green build is the push gate: push here so every run that produces a tested
	# head lands it on the fork, even when a later deploy fails.
	cmd_push
}

cmd_deploy() {
	[ -n "${DEPLOY_CMD:-}" ] || { echo "integration: DEPLOY_CMD not set in $CONF" >&2; exit 2; }
	local sha base bd
	sha="$(git -C "$REPO_DIR" rev-parse "$BRANCH")"
	bd="$(cat "$CACHE/build-dir" 2>/dev/null || true)"
	[ -n "$bd" ] && [ -d "$bd" ] || { echo "integration: no build dir; run: integration build" >&2; exit 1; }
	base="$(cat "$CACHE/base-ref" 2>/dev/null || echo unknown)"
	export BUILD_DIR="$bd" DEPLOY_SHA="$sha" DEPLOY_BASE="$base"
	eval "$DEPLOY_CMD" 9>&-
	if [ -n "${POST_CMD:-}" ]; then
		echo "integration: running post-deploy commands"
		eval "$POST_CMD" 9>&-
	fi
	printf %s "$sha" > "$CACHE/last-deploy"
	echo "integration: deployed ${sha:0:10} (base $base)"
}

cmd_push() {
	local key pre remote known
	key="${BRANCH//\//--}"
	pre="$(cat "$CACHE/$key.pre-sha" 2>/dev/null || true)"
	# The lease must be the branch's CURRENT remote tip, not the sha recorded
	# when the rebase started: pushing the same branch twice in one session
	# (fix, rebuild, push again) otherwise fails as "stale info". Fetch it, then
	# refuse when that tip is neither the pre-rebase sha nor a sha this script
	# pushed — that means someone else moved the branch and force-pushing would
	# discard their work.
	remote="$(remote_sha "$FORK_REMOTE" "$BRANCH")"
	if [ -n "$pre" ] && [ "$remote" != "$pre" ]; then
		known=""
		if [ -f "$CACHE/$key.pushed" ] && grep -qx "$remote" "$CACHE/$key.pushed"; then known=1; fi
		[ -n "$known" ] || {
			echo "integration: FATAL $FORK_REMOTE/$BRANCH moved to ${remote:0:9} (expected ${pre:0:9}); refusing to force-push" >&2
			exit 1
		}
	fi
	git -C "$REPO_DIR" push --force-with-lease="refs/heads/$BRANCH:$remote" "$FORK_REMOTE" "$BRANCH"
	pushed="$(remote_sha "$FORK_REMOTE" "$BRANCH")"
	local_branch="$(git -C "$REPO_DIR" rev-parse "$BRANCH")"
	if [ "$pushed" != "$local_branch" ]; then
		echo "integration: FATAL push did not land ($FORK_REMOTE/$BRANCH = ${pushed:0:9}, local $local_branch)" >&2
		exit 1
	fi
	printf '%s\n' "$pushed" >> "$CACHE/$key.pushed"
	rm -f "$CACHE/$key.pre-sha"
	echo "integration: pushed $BRANCH to $FORK_REMOTE (verified ${pushed:0:9})"
}

# The remote holding PR #num's head branch when that is not FORK_REMOTE (e.g. a
# personal fork): our own PRs may be opened from there while FORK_REMOTE keeps
# the copy the rebuild squashes. Empty for FORK_REMOTE-headed PRs and for
# EXTRA_PRS, whose upstream head belongs to someone else and is never pushed.
pr_head_remote() { # num -> remote name or empty
	local num="$1" pair repo r url
	for pair in ${EXTRA_PRS:-}; do
		[ "${pair%%=*}" = "$num" ] && return 0
	done
	repo="$(gh pr view "$num" --repo "$UPSTREAM" --json headRepository,headRepositoryOwner \
		--jq '.headRepositoryOwner.login + "/" + .headRepository.name')" || exit 1
	for r in $(git -C "$REPO_DIR" remote); do
		url="$(git -C "$REPO_DIR" remote get-url "$r")"
		case "${url%.git}" in
		*"github.com/$repo" | *"github.com:$repo")
			[ "$r" = "$FORK_REMOTE" ] || echo "$r"
			return 0
			;;
		esac
	done
	echo "integration: PR #$num head repo $repo has no git remote in $REPO_DIR; add one" >&2
	exit 1
}

# Fast-forward FORK_REMOTE's copy of an upstream base branch, so companion PRs
# opened inside the fork (review-only twins of upstream PRs) diff against the
# same base as their upstream PR. A fork base holding its own commits is left
# alone with a warning: that is the owner's call, never a force-push here.
sync_fork_base() { # base
	local base="$1" fork_sha up_sha slug
	fork_sha="$(remote_sha "$FORK_REMOTE" "$base" 2>/dev/null)" || return 0
	up_sha="$(git -C "$REPO_DIR" rev-parse "upstream/$base")"
	[ "$fork_sha" != "$up_sha" ] || return 0
	if ! git -C "$REPO_DIR" merge-base --is-ancestor "$fork_sha" "$up_sha"; then
		echo "integration: WARNING $FORK_REMOTE/$base (${fork_sha:0:9}) has commits upstream/$base lacks; not fast-forwarding it" >&2
		return 0
	fi
	git -C "$REPO_DIR" push "$FORK_REMOTE" "$up_sha:refs/heads/$base"
	[ "$(remote_sha "$FORK_REMOTE" "$base")" = "$up_sha" ] || {
		echo "integration: FATAL fast-forward of $FORK_REMOTE/$base did not land" >&2
		exit 1
	}
	echo "integration: fast-forwarded $FORK_REMOTE/$base to upstream/$base (${up_sha:0:9})"
	# GitHub keeps an open PR's recorded base commit after its base branch moves,
	# so the fork's companion PRs kept listing the old upstream commits;
	# re-setting the base makes it recompute.
	slug="$(git -C "$REPO_DIR" remote get-url "$FORK_REMOTE" | sed -E 's#^.*github\.com[:/]##; s#\.git$##')"
	gh pr list --repo "$slug" --base "$base" --state open --json number --jq '.[].number' |
		while read -r num; do
			gh api -X PATCH "repos/$slug/pulls/$num" -f base="$base" --silent ||
				echo "integration: WARNING could not refresh base of $slug#$num" >&2
		done
}

cmd_prs() {
	[ -n "${UPSTREAM:-}" ] || { echo "integration: UPSTREAM not set; skipping prs"; return 0; }
	git -C "$REPO_DIR" fetch "$FORK_REMOTE" --prune
	git -C "$REPO_DIR" fetch upstream --prune
	local root num branch base wt pre rows head_remote head_pre parent parent_branch onto lbl
	rows="$(pr_rows base)"
	root="$(worktrees_root)"
	while read -r base; do
		[ -n "$base" ] && sync_fork_base "$base"
	done <<< "$(printf '%s\n' "$rows" | cut -f3 | sort -u)"
	while IFS=$'\t' read -r num branch base; do
		[ -n "$num" ] || continue
		lbl="$(pr_label "$num")"
		rebased_onto="$(git -C "$REPO_DIR" rev-parse "upstream/$base")"
		head_remote="$(pr_head_remote "$num")" || exit 1
		# FORK_REMOTE is the source that gets rebased, so the PR head must hold
		# nothing it lacks: a commit pushed only to the head would be overwritten.
		if [ -n "$head_remote" ]; then
			# Explicit refspec: a remote without a fetch refspec only updates
			# FETCH_HEAD, leaving a stale $head_remote/$branch behind.
			git -C "$REPO_DIR" fetch "$head_remote" "+refs/heads/$branch:refs/remotes/$head_remote/$branch"
			head_pre="$(git -C "$REPO_DIR" rev-parse "$head_remote/$branch")"
			if ! git -C "$REPO_DIR" merge-base --is-ancestor "$head_pre" "$FORK_REMOTE/$branch"; then
				echo "integration: PR $lbl head $head_remote/$branch (${head_pre:0:9}) has commits $FORK_REMOTE/$branch lacks; reconcile them first" >&2
				exit 1
			fi
		fi
		parent="$(stack_parent "$num")"
		local -a open_parents=() open_pbs=()
		local p pb join_commit join_new match i
		for p in ${parent//,/ }; do
			pb="$(row_branch "$p" "$rows")"
			if [ -n "$pb" ]; then
				open_parents+=("$p")
				open_pbs+=("$pb")
			else
				echo "integration: PR $lbl is stacked on $(pr_label "$p"), which is not open" >&2
			fi
		done
		wt="$root/pr-$num"
		if [ -d "$wt" ] && rebase_in_progress "$wt"; then
			echo "integration: resuming PR $lbl rebase in $wt"
			( cd "$wt" && GIT_EDITOR=true git rebase --continue )
		elif [ -d "$wt" ] && [ -f "$(git -C "$wt" rev-parse --git-dir 2>/dev/null)/MERGE_HEAD" ]; then
			echo "integration: resuming PR $lbl parent join in $wt"
			git -C "$wt" commit --no-edit -q
			join_commit="$(git -C "$REPO_DIR" rev-list --merges --first-parent "$rebased_onto..$FORK_REMOTE/$branch" | head -1)"
			[ -n "$join_commit" ] || join_commit="$(git -C "$REPO_DIR" rev-list --merges -n 1 "$FORK_REMOTE/$branch")"
			join_new="$(git -C "$wt" rev-parse HEAD)"
			( cd "$wt" && git rebase --onto "$join_new" "$join_commit" "$FORK_REMOTE/$branch" )
		else
			git -C "$REPO_DIR" worktree remove --force "$wt" 2>/dev/null || rm -rf "$wt"
			git -C "$REPO_DIR" worktree add --detach "$wt" "$FORK_REMOTE/$branch" >/dev/null
			if [ "${#open_parents[@]}" -eq 0 ]; then
				echo "integration: PR $lbl rebasing $branch onto upstream/$base"
				( cd "$wt" && git rebase "upstream/$base" )
			elif [ "${#open_parents[@]}" -eq 1 ]; then
				parent_branch="${open_pbs[0]}"
				# The parent was rebased and pushed earlier (this run or an interrupted
				# one); replay only the child's own commits onto its new tip. The
				# remote-tracking reflog remembers the parent tip the child was cut
				# from; without that entry, fall back to the plain merge base.
				onto="$(git -C "$REPO_DIR" merge-base --fork-point "$FORK_REMOTE/$parent_branch" "$FORK_REMOTE/$branch" ||
					git -C "$REPO_DIR" merge-base "$FORK_REMOTE/$parent_branch" "$FORK_REMOTE/$branch")"
				echo "integration: PR $lbl rebasing $branch onto $(pr_label "${open_parents[0]}") ($FORK_REMOTE/$parent_branch)"
				( cd "$wt" && git rebase --onto "$FORK_REMOTE/$parent_branch" "$onto" )
			else
				join_commit="$(git -C "$REPO_DIR" rev-list --merges --first-parent "$rebased_onto..$FORK_REMOTE/$branch" | head -1)"
				[ -n "$join_commit" ] || join_commit="$(git -C "$REPO_DIR" rev-list --merges -n 1 "$FORK_REMOTE/$branch")"
				match=1
				for i in "${!open_parents[@]}"; do
					pb="${open_pbs[$i]}"
					if [ "$(git -C "$REPO_DIR" rev-parse "$join_commit^$((i + 1))" 2>/dev/null || true)" != "$(git -C "$REPO_DIR" rev-parse "$FORK_REMOTE/$pb")" ]; then
						match=0
						break
					fi
				done
				if [ "$match" -eq 1 ]; then
					echo "integration: PR $lbl ($branch) already joined on ${parent} (${open_pbs[*]})"
				else
					echo "integration: PR $lbl joining parents ${parent} (${open_pbs[*]}) and rebasing $branch"
					git -C "$wt" checkout -q --detach "$FORK_REMOTE/${open_pbs[0]}"
					for pb in "${open_pbs[@]:1}"; do
						if ! git -C "$wt" merge --no-edit "$FORK_REMOTE/$pb"; then
							if [ -n "$(git -C "$wt" diff --diff-filter=U --name-only)" ]; then
								echo "integration: PR $lbl parent join conflicted in $wt" >&2
								exit 1
							fi
							git -C "$wt" commit --no-edit -q
						fi
					done
					join_new="$(git -C "$wt" rev-parse HEAD)"
					( cd "$wt" && git rebase --onto "$join_new" "$join_commit" "$FORK_REMOTE/$branch" )
				fi
			fi
		fi
		pre="$(git -C "$REPO_DIR" rev-parse "$FORK_REMOTE/$branch")"
		# The base must still be the FETCHED upstream ref after the rebase: a long
		# conflict session can let upstream/$base move, which would mean the branch
		# was just rebased onto a base nobody ships. Fail loudly instead of pushing.
		git -C "$REPO_DIR" fetch upstream "$base"
		if [ "$(git -C "$REPO_DIR" rev-parse "upstream/$base")" != "$rebased_onto" ]; then
			echo "integration: PR $lbl base upstream/$base moved during rebase; re-run integration prs" >&2
			exit 1
		fi
		# Lease expect must come from a fetch of the exact head ref, not a stale tracking ref.
		git -C "$REPO_DIR" fetch "$FORK_REMOTE" "$branch"
		pre="$(git -C "$REPO_DIR" rev-parse "$FORK_REMOTE/$branch")"
		git -C "$wt" push --force-with-lease="refs/heads/$branch:$pre" "$FORK_REMOTE" "HEAD:refs/heads/$branch"
		# Verify the push actually landed before claiming success.
		pushed="$(remote_sha "$FORK_REMOTE" "$branch")"
		if [ "$pushed" != "$(git -C "$wt" rev-parse HEAD)" ]; then
			echo "integration: FATAL PR $lbl push did not land (origin/$branch = ${pushed:0:9})" >&2
			exit 1
		fi
		if [ -n "$head_remote" ]; then
			git -C "$wt" push --force-with-lease="refs/heads/$branch:$head_pre" "$head_remote" "HEAD:refs/heads/$branch"
			if [ "$(remote_sha "$head_remote" "$branch")" != "$(git -C "$wt" rev-parse HEAD)" ]; then
				echo "integration: FATAL PR $lbl push to $head_remote/$branch did not land" >&2
				exit 1
			fi
		fi
		git -C "$REPO_DIR" worktree remove --force "$wt"
		echo "integration: PR $lbl rebased onto upstream/$base and pushed to $FORK_REMOTE${head_remote:+ and $head_remote} (verified ${pushed:0:9})"
	done <<< "$rows"
}

case "$CMD" in
rebuild) cmd_rebuild ;;
build)  cmd_build ;;
deploy) cmd_deploy ;;
push)   cmd_push ;;
prs)    cmd_prs ;;
# PRs are refreshed onto their upstream base first: rebuild squashes exactly what
# each PR branch holds, so a stale PR would otherwise integrate stale code.
all)    cmd_prs; cmd_rebuild; cmd_build; cmd_deploy ;;
*) echo "integration: unknown command $CMD" >&2; exit 2 ;;
esac
