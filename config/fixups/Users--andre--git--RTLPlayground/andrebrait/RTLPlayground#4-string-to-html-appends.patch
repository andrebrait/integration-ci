+/* copied verbatim from rtlplayground.c: html_out.c's string_to_html() calls it */
+uint16_t strtox(__xdata uint8_t *dst, __code const char *s)
+{
+	__xdata uint8_t *b = dst;
+	while (*s)
+		*dst++ = *s++;
+	*dst = 0;
+	return dst - b;
+}
