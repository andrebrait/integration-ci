[Unit]
Description=pr-watcher: notify omp sessions about pull request activity through omp-web
After=network-online.target ompweb-api.service
Wants=network-online.target

[Service]
# Supplies OMP_WEB_TRUSTED_HEADER_SECRET (mode 0600, read only by this unit);
# omp-web holds only its SHA-256 as OMP_WEB_TRUSTED_HEADER_SHA256.
EnvironmentFile=/opt/omp-deployment/pr-watcher.env
Environment=HOME=/root
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/root/.nvm/versions/node/v26.8.1/bin/node /root/git/integration-ci/pr-watcher/pr-watcher.mjs
User=root
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
